<UserControl x:Class="HotelApp.Views.RoomsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:HotelApp.ViewModels">
    <UserControl.DataContext>
        <vm:RoomsViewModel/>
    </UserControl.DataContext>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Фильтры -->
            <RowDefinition Height="Auto"/> <!-- 1: Заголовок -->
            <RowDefinition Height="Auto"/> <!-- 2: Кнопки CRUD -->
            <RowDefinition Height="*"/>    <!-- 3: Таблица -->
        </Grid.RowDefinitions>

        <!-- 0. Панель поиска и фильтров -->
        <Border Grid.Row="0" Background="#F5F5F5" Padding="10" Margin="0,0,0,10" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <TextBlock Text="Поиск:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="28" Padding="5,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                    <TextBlock Text="Тип номера:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding RoomTypes}" 
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding SelectedRoomTypeId}"
                              Width="150" Height="28"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,10,0">
                    <TextBlock Text="Статус:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Statuses}" 
                              SelectedIndex="{Binding SelectedStatusId}"
                              Width="150" Height="28"/>
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="Сортировка:" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox ItemsSource="{Binding SortOptions}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="PropertyName"
                                  SelectedValue="{Binding SortProperty}"
                                  Width="120" Height="28"/>
                        <Button Content="↑↓" Width="30" Height="28" Margin="5,0,0,0" ToolTip="Изменить направление"
                                Click="BtnToggleSort_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Заголовок списка -->
        <TextBlock Grid.Row="1" Text="Каталог номеров" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- 2. Панель управления (активна только для админа) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить номер" Width="120" Height="28" Margin="0,0,10,0" 
                    Command="{Binding AddRoomCommand}" IsEnabled="{Binding IsAdmin}"/>
            <Button Content="Редактировать" Width="120" Height="28" Margin="0,0,10,0" 
                    Command="{Binding EditRoomCommand}" IsEnabled="{Binding IsAdmin}"/>
            <Button Content="Удалить" Width="120" Height="28" Margin="0,0,10,0" Background="#FF5252" Foreground="White" 
                    Command="{Binding DeleteRoomCommand}" IsEnabled="{Binding IsAdmin}"/>
        </StackPanel>

        <!-- 3. Список номеров -->
        <DataGrid Grid.Row="3" 
                  ItemsSource="{Binding RoomsView}" 
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  RowBackground="White"
                  AlternatingRowBackground="#F9F9F9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="80"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding RoomType.Name}" Width="120"/>
                <DataGridTextColumn Header="Этаж" Binding="{Binding Floor}" Width="60"/>
                <DataGridTextColumn Header="Цена/сутки" Binding="{Binding PricePerDay, StringFormat={}{0:N0} ₽}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>