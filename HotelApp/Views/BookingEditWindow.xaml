<Window x:Class="HotelApp.Views.BookingEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Бронирование" Height="500" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 0: Гость label -->
            <RowDefinition Height="Auto"/>  <!-- 1: Гость combo -->
            <RowDefinition Height="Auto"/>  <!-- 2: Номер label -->
            <RowDefinition Height="Auto"/>  <!-- 3: Номер combo -->
            <RowDefinition Height="Auto"/>  <!-- 4: Дата заезда label -->
            <RowDefinition Height="Auto"/>  <!-- 5: Дата заезда picker -->
            <RowDefinition Height="Auto"/>  <!-- 6: Дата выезда label -->
            <RowDefinition Height="Auto"/>  <!-- 7: Дата выезда picker -->
            <RowDefinition Height="Auto"/>  <!-- 8: Итого -->
            <RowDefinition Height="*"/>     <!-- 9: Кнопки -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Гость:" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="1" x:Name="cmbUser" Height="28" Margin="0,0,0,10" DisplayMemberPath="FullName" SelectedValuePath="Id"/>

        <TextBlock Grid.Row="2" Text="Номер:" Margin="0,0,0,5"/>
        <ComboBox Grid.Row="3" x:Name="cmbRoom" Height="28" Margin="0,0,0,10" DisplayMemberPath="Number" SelectedValuePath="Id" SelectionChanged="CmbRoom_SelectionChanged"/>

        <TextBlock Grid.Row="4" Text="Дата заезда:" Margin="0,0,0,5"/>
        <DatePicker Grid.Row="5" x:Name="dpCheckIn" Height="28" Margin="0,0,0,10" SelectedDateChanged="Date_SelectedDateChanged"/>

        <TextBlock Grid.Row="6" Text="Дата выезда:" Margin="0,0,0,5"/>
        <DatePicker Grid.Row="7" x:Name="dpCheckOut" Height="28" Margin="0,0,0,10" SelectedDateChanged="Date_SelectedDateChanged"/>

        <TextBlock x:Name="txtTotal" Grid.Row="8" Text="Итого: 0 ₽" FontSize="16" FontWeight="Bold" Margin="0,10,0,10" HorizontalAlignment="Right"/>

        <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Сохранить" Width="100" Height="30" Margin="0,0,10,0" Click="BtnSave_Click" IsDefault="True"/>
            <Button Content="Отмена" Width="100" Height="30" Click="BtnCancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>