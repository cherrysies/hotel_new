<Window x:Class="HotelApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HotelApp.Views"
        Title="Гостиница - Главная" 
        Height="700" 
        Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#2196F3" Padding="10">
            <DockPanel>
                <TextBlock x:Name="txtUserInfo" 
                           DockPanel.Dock="Left" 
                           FontSize="14" 
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" 
                        Content="Выйти" 
                        Padding="20,5"
                        Background="#1976D2"
                        Foreground="White"
                        Click="BtnLogout_Click"/>
            </DockPanel>
        </Border>

        <!-- Основная область с вкладками -->
        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Каталог номеров">
                <views:RoomsView/>
            </TabItem>
            <TabItem Header="Бронирования">
                <views:BookingsView/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>